# 複製為 backend/.env 後填入本機值；.env 已被 .gitignore 排除，切勿提交。
# Spring Boot 會透過 spring.config.import 自動讀取 backend/.env（若存在）。
SPRING_PROFILES_ACTIVE=dev

# JDBC URL 格式
DATABASE_URL=jdbc:postgresql://localhost:5432/sndc_ims
DATABASE_USERNAME=sndc
DATABASE_PASSWORD=change-me

# 必填（Phase 2 起）。未設定時後端會拒絕啟動並顯示原因。
# JWT_SECRET：至少 32 個字元的隨機字串。PowerShell 產生方式：
#   $b = New-Object byte[] 48; [Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($b); [Convert]::ToBase64String($b)
JWT_SECRET=
# Token 有效期限（ISO-8601 Duration），預設 12 小時
JWT_EXPIRATION=PT12H
# 團部通行碼：只有知道此碼的人才能註冊
DEPARTMENT_REGISTRATION_CODE=

# AI 助理（Groq）。選填：未設定時只有 AI 助理無法使用。
# 金鑰在 https://console.groq.com/keys 建立；只放在這裡，絕不放進 App 或 Git。
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# gpt-oss 系列可設 low／medium／high；換成其他模型時請留空
GROQ_REASONING_EFFORT=low

APP_BASE_URL=http://localhost:8080
APP_TIMEZONE=Africa/Nairobi

# 只監聽本機；手機經 tailscale serve 以 HTTPS 連入。請勿改成 0.0.0.0。
SERVER_ADDRESS=127.0.0.1
PORT=8080

# Phase 3 起使用（照片存本機磁碟，須納入備份）
IMAGE_STORAGE_PROVIDER=local
IMAGE_STORAGE_PATH=./storage/images
